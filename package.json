{
  "name": "abba-ui",
  "version": "0.0.0",
  "private": true,
  "description": "ABBA Design System — monorepo for the @abbainitiative/ui component library and its documentation site.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:package": "node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=@abbainitiative/ui && changeset publish",
    "preflight": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
